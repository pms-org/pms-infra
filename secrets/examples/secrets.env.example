# PostgreSQL Credentials
# For local development, use these defaults (they match the base manifests):
# POSTGRES_USER=pms
# POSTGRES_PASSWORD=pms
# POSTGRES_DB=pmsdb
# For custom setup, replace with your values:
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=your_database_name

# RabbitMQ Credentials
# For local development, use these defaults:
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest
# For custom setup, replace with your values:
RABBITMQ_DEFAULT_USER=your_rabbitmq_username
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password

# Kafka Cluster ID (must be unique for KRaft mode)
# For local development, you can use any unique string:
# KAFKA_CLUSTER_ID=local_kafka_cluster_001
# For custom setup, replace with your value:
KAFKA_CLUSTER_ID=your_unique_kafka_cluster_id

# AWS Secrets Manager (for production environments)
# AWS_REGION=us-east-1
# AWS_SECRETS_MANAGER_ENDPOINT=https://secretsmanager.us-east-1.amazonaws.com
