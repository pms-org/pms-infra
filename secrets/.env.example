# ==========================================
# PMS Infrastructure - Local Development Secrets
# ==========================================
# 
# NEVER COMMIT THIS FILE TO GIT
# Copy this file to .env and fill in actual values
#
# For Kubernetes deployments, secrets come from:
# - DEV: secretGenerator in kustomization.yaml (temporary)
# - PROD: AWS Secrets Manager via External Secrets Operator
# ==========================================

# PostgreSQL Database
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
POSTGRES_DB=pmsdb
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pmsdb

# Spring DataSource Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pmsdb
SPRING_DATASOURCE_USERNAME=pms
SPRING_DATASOURCE_PASSWORD=pms
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Generic DataSource (for non-Spring services)
DATASOURCE_USER=pms
DATASOURCE_PASS=pms
DATASOURCE_DRIVER=org.postgresql.Driver

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Kafka Configuration
KAFKA_CLUSTER_ID=dOFfvAcdQZKE60Enfcsefg

# Application Configuration (Non-sensitive)
SPRING_PROFILES_ACTIVE=dev
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Service Endpoints
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_STREAM_PORT=5552
RABBITMQ_STREAM_NAME=trade-stream

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SCHEMA_REGISTRY_URL=http://schema-registry:8081
SPRING_KAFKA_PROPERTIES_SCHEMA_REGISTRY_URL=http://schema-registry:8081

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=2s

# Database Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_DDL_AUTO=update
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
DATASOURCE_HIKARI_POOL_SIZE=10

# Kafka Topics
INCOMING_TRADES_TOPIC=raw-trades-topic
OUTGOING_VALID_TRADES_TOPIC=valid-trades-topic
OUTGOING_INVALID_TRADES_TOPIC=invalid-trades-topic

# Kafka Consumer
KAFKA_CONSUMER_GROUP_ID=pms-dev-consumer-group

# RabbitMQ Stream
APP_RABBIT_STREAM_HOST=rabbitmq
APP_RABBIT_STREAM_PORT=5552
APP_RABBIT_STREAM_NAME=trade-stream
APP_RABBIT_STREAM_CONSUMER_NAME=trade-capture-group

# Application Server
SERVER_PORT=8080
SPRING_APPLICATION_NAME=pms-dev

# Batch Processing
BATCH_SIZE=500
BATCH_TIMEOUT_MS=100
JDBC_BATCH_SIZE=500
