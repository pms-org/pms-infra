# Example Configuration for Simulation Service
# Copy this file and update with your actual values
#
# For Development: cp simulation.properties.example simulation.properties

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_STREAM_PORT=5552
RABBITMQ_STREAM_NAME=trade-stream

# Database Configuration
DB_HOST=postgres
DB_NAME=pmsdb
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pmsdb
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Schema Registry
SCHEMA_REGISTRY_URL=http://schema-registry:8081
SPRING_KAFKA_PROPERTIES_SCHEMA_REGISTRY_URL=http://schema-registry:8081
