{
	"info": {
		"_postman_id": "pms-platform-api-collection",
		"name": "PMS Platform API",
		"description": "Portfolio Management System API endpoints for authentication, portfolio management, and simulation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Get USER Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"access_token\", response.accessToken);",
									"    console.log(\"Token saved:\", response.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticate and receive USER token. Token is automatically saved to environment variable."
					},
					"response": []
				},
				{
					"name": "Get SERVICE Token (OAuth2)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"service_token\", response.access_token);",
									"    console.log(\"Service token saved:\", response.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "service-client",
									"type": "string"
								},
								{
									"key": "password",
									"value": "service-secret",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "service",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/oauth2/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"oauth2",
								"token"
							]
						},
						"description": "Get SERVICE token for service-to-service communication"
					},
					"response": []
				}
			]
		},
		{
			"name": "Portfolio Service",
			"item": [
				{
					"name": "Create Portfolio",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe Portfolio\",\n    \"phoneNumber\": 1234567890,\n    \"address\": \"123 Main Street, New York\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/portfolio/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"portfolio",
								"create"
							]
						},
						"description": "Create a new portfolio. Requires USER token authentication."
					},
					"response": []
				},
				{
					"name": "Get Portfolio by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/portfolio/:portfolioId",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"portfolio",
								":portfolioId"
							],
							"variable": [
								{
									"key": "portfolioId",
									"value": "42034319-9cae-4637-b2ed-189064ce4326"
								}
							]
						},
						"description": "Retrieve portfolio details by portfolio ID"
					},
					"response": []
				}
			]
		},
		{
			"name": "Simulation Service",
			"item": [
				{
					"name": "Create Portfolio (Simulation)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Simulation Portfolio\",\n    \"phoneNumber\": 9876543210,\n    \"address\": \"456 Simulation Ave, Test City\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/simulation/create-portfolio",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"simulation",
								"create-portfolio"
							]
						},
						"description": "Create portfolio via simulation service. Requires USER token authentication. Data is stored in the same portfolio database."
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Checks",
			"item": [
				{
					"name": "Frontend Health",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								""
							]
						},
						"description": "Check if frontend is accessible"
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://k8s-pms-pmsingre-ba04040d46-1513529560.us-east-1.elb.amazonaws.com",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "service_token",
			"value": "",
			"type": "string"
		}
	]
}
